# Application
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BASE_DOMAIN=localhost

# Database
DATABASE_URL=mongodb://localhost:27017/electronics
BACKUP_DATABASE_URL=

# Security & JWT
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_SECRET_KEY=replace-with-strong-random-secret
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
RESET_PASS_TOKEN_SECRET=replace-with-strong-reset-secret
RESET_PASS_TOKEN_EXPIRES_IN=10m

# Super Admin Bootstrap
SUPER_ADMIN_EMAIL=admin@masheco.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password

# Media Storage Provider ('cloudinary' or 'r2')
# Keep 'cloudinary' until R2 bucket, custom domain (media.masheco.com), and credentials are verified.
MEDIA_STORAGE_PROVIDER=cloudinary
MEDIA_ANALYTICS_SYNC=false

# Legacy / Active Cloudinary Storage (do NOT remove while legacy images exist)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 Storage (server-side only — NEVER expose to frontend)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=masheco-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.masheco.com

# Cloudflare API (for custom domains & optional analytics)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Storefront Integration
STOREFRONT_API_KEY=

# Mailer (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SMTP_FROM=contact@masheco.com
